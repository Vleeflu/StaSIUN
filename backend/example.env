PROJECT_NAME="StaSIUN"
DATABASE_URL=postgresql+psycopg://stasiun:stasiun@localhost:5432/stasiun

# Kredensial Geoserver MAPID, dipakai backend untuk menarik ISI DATA layer
# (stasiun, isochrone). Beda dari basemap key yang ada di example.env root —
# basemap key untuk menggambar peta di browser, yang ini untuk mengambil data
# di server. Keduanya tidak bisa saling menggantikan.
# api_key dan project_id sama untuk semua layer dalam satu proyek; yang
# berbeda per layer hanya layer_id, dan itu didaftarkan di data/layers.yml.
MAPID_GEOSERVER_URL=https://geoserver.mapid.io
MAPID_API_KEY=your_api_key_here
MAPID_PROJECT_ID=your_project_id_here
MAPID_BASEMAP_KEY=

# Model bahasa untuk panel AI Insight. Namanya netral penyedia karena kode
# memakai SDK OpenAI yang bisa diarahkan ke layanan mana pun yang menyediakan
# endpoint OpenAI-compatible. Penyedia sekarang: Groq.
#
# LLM_MODEL wajib berisi id model yang memang tersedia di penyedia Anda. Kalau
# salah, kegagalannya baru muncul saat chat dipakai, bukan saat backend start.
# Daftar model yang benar-benar tersedia bisa dilihat dengan:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
