# Copy to .env — Docker Compose reads it automatically.
#   cp example.env .env      (Linux/macOS)
#   copy example.env .env    (Windows)

# MAPID basemap key, inlined into the frontend at build time. Without it the
# map still runs but the MAPID basemap tiles will not load.
# Get one at https://maps.mapid.io
NEXT_PUBLIC_MAPID_KEY=

# Address the browser uses to reach the backend. The default matches the
# host-mapped backend port and works for local Docker use as-is.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — only needed if you set SEED_SOURCE=mapid on the backend service
# to seed live data from Geoserver MAPID instead of the bundled GeoJSON.
MAPID_API_KEY=
MAPID_PROJECT_ID=
