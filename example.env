# Copy to .env — Docker Compose reads it automatically.
#   cp example.env .env      (Linux/macOS)
#   copy example.env .env    (Windows)

# MAPID basemap key, inlined into the frontend at build time. Without it the
# map still runs but the MAPID basemap tiles will not load.
# Get one at https://maps.mapid.io
NEXT_PUBLIC_MAPID_KEY=

# Address the browser uses to reach the backend. The default matches the
# host-mapped backend port and works for local Docker use as-is. On a public
# server set it to the server's IP or domain, e.g. http://203.0.113.5:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origins allowed through the backend's CORS (JSON list). Must include the exact
# origin the browser loads the frontend from. On a public server, e.g.
#   CORS_ORIGINS=["http://203.0.113.5:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# Optional — only needed if you set SEED_SOURCE=mapid on the backend service
# to seed live data from Geoserver MAPID instead of the bundled GeoJSON.
MAPID_API_KEY=
MAPID_PROJECT_ID=

# Model bahasa untuk panel AI Insight. Tanpa ini peta dan API stasiun tetap
# jalan, hanya asistennya yang menolak menjawab.
# Penyedia sekarang Groq; berpindah penyedia cukup mengubah LLM_BASE_URL dan
# LLM_MODEL di backend/.env, tanpa menyentuh kode.
LLM_API_KEY=
